          <mxGeometry x="70" y="925" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="D5" value="Tìm rag_documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="1000" width="200" height="45" as="geometry" />
        </mxCell>

        <mxCell id="D2" value="POST /api/media/search&#10;VideoRetrievalService (rag_video_anh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="760" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="D4" value="NHÚNG CÂU HỎI — MỘT LẦN&#10;embed_query(query)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9a0;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="845" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="D6" value="Tìm media_clip&#10;(ảnh + keyframe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="925" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="D7" value="Tìm video_transcript&#10;(lời thoại)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="925" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="D8" value="Gộp + xếp hạng + dựng chuỗi context&#10;kèm source_url và mốc thời gian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="1000" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="D9" value="GET /api/media-files/*&#10;→ 307 presigned MinIO&#10;(Range 206 → tua video)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="760" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="N5" value="MỘT vector dùng chung cho HAI collection media.&#10;Cả hệ thống nhúng bằng jina-clip-v2, 1024 chiều, nên câu hỏi&#10;chỉ nhúng một lần rồi xếp hạng được cả ảnh lẫn lời thoại trong&#10;cùng không gian. Đây là tính chất cốt lõi, không phải sơ suất.&#10;&#10;NHƯNG nhánh nội quy nhúng RIÊNG một lần nữa: nó đi qua&#10;LangChain nên là client khác, gửi input kiểu OpenAI [&quot;chuỗi&quot;],&#10;còn nhánh media gửi kiểu Jina [{text: ...}]. Pod nhận cả hai.&#10;=&gt; Pod chết là CẢ HAI nhánh chết, không phải chỉ nhánh media." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="845" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="N6" value="KHÔNG có ngưỡng điểm để nói 'không tìm thấy' (T-33).&#10;Đo thật: điểm cao nhất câu ngoài miền 0,389 CHỒNG LẤN&#10;điểm thấp nhất câu trong miền 0,254 — không ngưỡng nào&#10;tách được. Việc từ chối vì thế nằm ở tầng trả lời (B2/B5).&#10;Ảnh tĩnh cố ý KHÔNG mang timestamp_sec và video_id,&#10;để một trích dẫn không thể bịa ra khoảnh khắc trong ảnh." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="960" width="430" height="105" as="geometry" />
        </mxCell>

