  <diagram id="luong-hoi-dap" name="Luồng hỏi đáp">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1420" math="0" shadow="0">
      <root>
