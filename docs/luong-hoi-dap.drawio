        <mxCell id="title" value="HIT-MIRA — Luồng từ câu hỏi đến câu trả lời (v1, đo ngày 02/08/2026)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="lane1" value="1 · TRÌNH DUYỆT — web/ (Next.js, :3000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#9fb3c8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#334e68;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="2 · LANGGRAPH :2024 — ChatBot/ SupervisorAgent (điều phối + sinh câu trả lời)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbf7ff;strokeColor=#b39ddb;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#4a148c;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="3 · MCP :8091 — mcp/ (ToolRegistry ↔ FeatureManager)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7fff7;strokeColor=#8bc48b;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#2e5c2e;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lane4" value="4 · API :8000 — API/src/ (truy xuất — KHÔNG có LLM sinh câu trả lời ở tầng này)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d9b26a;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#7a5c00;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1320" height="420" as="geometry" />
        </mxCell>
        <mxCell id="lane5" value="5 · HẠ TẦNG DỮ LIỆU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="1320" height="150" as="geometry" />
        </mxCell>

        <mxCell id="A1" value="Người dùng gõ&#10;câu hỏi tiếng Việt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="95" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="① lgStream()&#10;SSE → :2024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="70" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="② searchMedia() + searchRegulations()&#10;gọi THẲNG :8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="140" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="Hiển thị: câu trả lời (chữ, stream dần)&#10;+ thẻ nguồn (ảnh · video tua ·&#10;điều khoản nội quy · link bài gốc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="95" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="N1" value="Hai đường CHẠY SONG SONG, có chủ ý.&#10;Agent viết câu trả lời; thẻ nguồn là bằng chứng&#10;nhìn được. Chờ agent xong mới gọi thì người dùng&#10;đợi hai lượt — và nhánh thẻ hỏng thì câu trả lời&#10;vẫn hiện bình thường (hitsStatus riêng)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="470" height="100" as="geometry" />
        </mxCell>

        <mxCell id="B1" value="SupervisorAgent.ainvoke()&#10;nạp supervisor_prompt.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="295" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="Thuộc phạm vi&#10;CLB HIT?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="285" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="B3" value="TỪ CHỐI — không gọi tool,&#10;không trả lời từ trí nhớ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="420" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="LLM CHỌN CÔNG CỤ&#10;= bước ĐỊNH TUYẾN (router)&#10;REQUIRED_TOOLS = 2 tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="290" width="210" height="65" as="geometry" />
        </mxCell>
        <mxCell id="B5" value="LLM SINH CÂU TRẢ LỜI&#10;bám ngữ cảnh tool trả về&#10;+ trích dẫn nguồn + disclaimer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="420" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="N2" value="MỤC II.1 PHẠM VI — chặn TRƯỚC khi gọi tool (BR-704).&#10;Trước khi có luật này, agent trả lời câu ngoài miền bằng&#10;kiến thức của mô hình: công thức phở 864 ký tự, quy trình&#10;thay nhớt xe kèm số liệu. Mọi luật chống bịa cũ đều gắn với&#10;'sau khi tool trả về' nên không chạm tới trường hợp này.&#10;Đo lại sau khi vá: 864 → 207 ký tự từ chối." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="285" width="530" height="105" as="geometry" />
        </mxCell>
        <mxCell id="N3" value="KHÔNG có classifier intent riêng (T-40 đổi thiết kế).&#10;Định tuyến chính là việc LLM chọn tool — đo được&#10;routing accuracy = 1,000 trên 12 truy vấn có nhãn.&#10;Thêm tool vào tools.yaml là CHƯA ĐỦ: phải khai thêm&#10;trong REQUIRED_TOOLS, nếu không agent không thấy nó." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="410" width="530" height="95" as="geometry" />
        </mxCell>

        <mxCell id="C1" value="ToolRegistry&#10;getattr(FeatureManager, tên)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="608" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="C2" value="search_regulations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="615" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="C3" value="search_media" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="615" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="N4" value="Một tool = 1 mục trong Resources/tools.yaml VÀ 1 method cùng tên trên FeatureManager.&#10;log_exceptions cố ý biến exception thành {success: false, error_type, message} — đó là hợp đồng của MCP,&#10;không phải nuốt lỗi." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="605" width="570" height="60" as="geometry" />
        </mxCell>

        <mxCell id="D1" value="POST /api/retrieval/search&#10;RetrievalService (rag_noiquy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="760" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="D3" value="VIẾT LẠI TRUY VẤN — gọi LLM&#10;bật MẶC ĐỊNH khi đi từ chatbot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="845" width="200" height="50" as="geometry" />
        </mxCell>
