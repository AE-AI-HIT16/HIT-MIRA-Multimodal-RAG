        <mxCell id="b2" value="&lt;b&gt;Ⓑ&lt;/b&gt; napTheKetQua() — Promise.all&lt;br&gt;&lt;i&gt;agent không tra nguồn nào&lt;br&gt;→ ẩn hẳn khối thẻ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="1270" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;Ⓒ&lt;/b&gt; Gọi lại đúng hai endpoint ⑨a / ⑨b&lt;br&gt;(có ảnh → /api/media/search-image)&lt;br&gt;&lt;i&gt;lần gọi thứ hai, thẳng từ trình duyệt&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
