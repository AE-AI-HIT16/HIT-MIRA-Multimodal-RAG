  <diagram name="Luồng query → câu trả lời" id="luong-query-1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;HIT-MIRA — luồng xử lý một câu hỏi: từ lúc người dùng gõ tới lúc câu trả lời được sinh ra&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="960" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="─── nét liền: luồng chính (① → ⑪)&#10;╌╌╌ nét đứt đỏ: đường trả về&#10;╌╌╌ nét đứt xám: nhánh thẻ kết quả (song song)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;strokeColor=#9E9E9E;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="4" width="290" height="46" as="geometry" />
        </mxCell>

        <mxCell id="bg1" value="Web — Next.js (:3000)" style="swimlane;html=1;startSize=40;horizontal=1;fillColor=#dae8fc;swimlaneFillColor=#FBFDFF;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
