        <mxCell id="title" value="HIT-MIRA — Luồng OFFLINE: từ dữ liệu crawl đến điểm trong Qdrant (số liệu thật 02/08/2026)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Tách hẳn khỏi đường online: mọi việc nặng làm trước, đường request chỉ còn nhúng câu hỏi + tìm vector (NFR).  ▸ Xem bản online: docs/luong-hoi-dap.drawio" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="36" width="1200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="lane0" value="0 · NGUỒN — dữ liệu crawl trên đĩa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
