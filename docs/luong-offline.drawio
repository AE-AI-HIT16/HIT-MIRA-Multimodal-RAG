        <mxCell id="lane4" value="4 · DỰNG ĐƠN VỊ TRUY HỒI — làm sạch, lọc, ghép ngữ cảnh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d9b26a;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#7a5c00;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lane5" value="5 · NHÚNG + INDEX — hai nhánh ĐỘC LẬP, point ID tất định" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#e0a0a0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#7a2020;" vertex="1" parent="1">
          <mxGeometry x="40" y="945" width="1420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="lane6" value="6 · KHO ĐÍCH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
