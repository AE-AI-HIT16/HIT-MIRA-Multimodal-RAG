        <mxCell id="S1" value="data/crawled_full/&#10;496 bài · post.json + ảnh + video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="105" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="Tài liệu nội quy (PDF/DOCX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="105" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="N0" value="Crawl tự động (BR-103) là hạng mục v2 — hiện dữ liệu được crawl bằng tay rồi đặt vào thư mục." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="105" width="330" height="50" as="geometry" />
        </mxCell>

        <mxCell id="U1" value="upload_crawled_data_to_minio.py&#10;→ MinIO events/&lt;post&gt;/media/..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="225" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="U2" value="register_minio_images.py&#10;register_minio_videos.py&#10;→ ghi posts + media vào PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="220" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="U3" value="Kết quả: 496 bài · 1.628 ảnh · 59 video&#10;(2.429 keyframe sinh ra ở bước sau)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="225" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="NU" value="Mọi script ghi/xoá đều DRY-RUN mặc định, phải có --apply mới chạy thật.&#10;Giữ quy ước này cho script mới." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="220" width="470" height="55" as="geometry" />
        </mxCell>

        <mxCell id="G1" value="runpod_video_job.py&#10;cấp presigned URL cho worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="355" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="G2" value="runpod_worker/handler.py&#10;chạy export_video_artifacts.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="355" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="G3" value="Trích KEYFRAME&#10;cắt cảnh + khử trùng lặp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="335" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G4" value="ASR — Zipformer (sherpa-onnx)&#10;cửa sổ 60 giây, có mốc thời gian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="400" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="G5" value="Gói MỘT file ZIP&#10;PUT ngược lên MinIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="365" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="G6" value="import_media_outputs.py&#10;nạp artifact vào PostgreSQL&#10;frames · transcripts · segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="360" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="NG2" value="⚠ BUG ĐÃ VÁ ở bước nạp artifact (import_media_outputs.py):&#10;`segment.get(&quot;start_sec&quot;) or segment.get(&quot;start_time&quot;)` — `0.0` là falsy nên mốc giây 0 rơi sang nhánh sau và thành NULL.&#10;Segment ĐẦU của MỌI transcript mất mốc → bộ dựng unit loại vì `invalid_timestamp` → 11 video mất sạch lời thoại,&#10;tổng 16,8% lời thoại (18.777/112.006 ký tự) không tìm kiếm được. Nay dùng `so_dau_tien()`, có 2 test chặn tái diễn." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe0e0;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="950" height="62" as="geometry" />
        </mxCell>

        <mxCell id="V1" value="caption_images.py&#10;chạy theo lô, nối tiếp được" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="610" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="V2" value="qwen_vision_service.py — VLM&#10;MỘT lần gọi → caption + OCR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="610" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="V3" value="detection_service&#10;nhận diện vật thể" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="610" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="V4" value="caption_results · ocr_results · object_results&#10;4.057 / 4.057 / 4.057 đều DONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e6;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="610" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="NV" value="Khâu BỊ BỎ QUA phải nói rõ là bỏ qua. `_pipeline_status` coi SKIPPED/NOT_FOUND là CHƯA XONG, trừ khi lý do chứa&#10;&quot;disabled by route&quot;. Sai chỗ này thì mọi lượt chạy đều báo partial_success và che mất lỗi thật.&#10;NOT_FOUND ≠ SKIPPED: ảnh không có chữ là kết quả HỢP LỆ (DONE), còn khâu chưa chạy phải để PENDING cho lượt sau nhặt." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="672" width="1360" height="36" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="build_video_retrieval_units.py&#10;retrieval_units.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="770" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="Làm sạch text (giữ dấu tiếng Việt)&#10;loại chuỗi lỗi, loại mốc thời gian sai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="770" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="LỌC keyframe theo object CÓ THẬT&#10;trong MinIO — TRƯỚC khi nhúng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9a0;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="770" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="R4" value="MediaClipUnit&#10;(ảnh + keyframe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="762" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="R5" value="VideoTranscriptUnit&#10;(đoạn lời thoại)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="818" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="NR" value="Vector và payload phải khớp 1:1 — nên lọc keyframe mất object TRƯỚC khi nhúng, không phải sau.&#10;summary.json ghi `skipped_by_reason` mỗi lần build. ĐỌC NÓ: chính dòng `invalid_timestamp: 1` đã nằm sẵn trên đĩa&#10;hàng tuần trước khi ai đó phát hiện 16,8% lời thoại biến mất.&#10;Ảnh tĩnh cố ý KHÔNG mang timestamp_sec và video_id — để trích dẫn không thể bịa ra khoảnh khắc trong một tấm ảnh." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="840" width="800" height="72" as="geometry" />
        </mxCell>
        <mxCell id="NR2" value="1 keyframe mồ côi: có dòng DB&#10;nhưng object đã mất trong MinIO&#10;→ bị lọc ở bước này (đúng ý đồ).&#10;4.057 media − 1 = 4.056 điểm." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="762" width="340" height="72" as="geometry" />
        </mxCell>

        <mxCell id="I1" value="index_image_units.py&#10;index_video_retrieval_units.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="985" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="I2" value="Nhúng ẢNH&#10;thu nhỏ 512px trước khi gửi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="980" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="I3" value="Nhúng LỜI THOẠI&#10;cùng model, cùng không gian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="1045" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="I4" value="Pod GPU — jina-clip-v2 (tự host)&#10;1024 chiều, cosine" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="995" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="I5" value="upsert Qdrant&#10;point ID = uuid5(khoá nghiệp vụ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="1010" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="NI" value="Point ID TẤT ĐỊNH ⇒ index lại là GHI ĐÈ, không nhân bản, và&#10;&quot;đã index chưa?&quot; trả lời được mà không cần bảng đánh dấu.&#10;&#10;Hai nhánh ĐỘC LẬP: video hỏng keyframe vẫn phải index được lời thoại.&#10;--payload-only : sửa caption/source_url mà KHÔNG nhúng lại (1.628 ảnh ~1 phút thay vì ~78 phút).&#10;--transcript-only : chỉ chạm lời thoại — dùng khi vá bug mốc giây, không đụng 2.428 keyframe." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="980" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="NI2" value="Caption đến SAU khi index — phân tích và index là hai bước rời, nên nhúng lại chỉ để gắn caption là đốt quota vô ích: dùng --payload-only.&#10;Lỗi nhà cung cấp 401/402/403 ⇒ ImageEmbeddingProviderFatalError, KHÔNG nuốt, dừng mẻ ngay. Trước khi có nó, 23 video liên tiếp index 0 điểm mà script vẫn in OK." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1105" width="1000" height="38" as="geometry" />
        </mxCell>

        <mxCell id="Q1" value="Qdrant media_clip&#10;4.056 điểm&#10;1.628 ảnh + 2.428 keyframe" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="1200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Q2" value="Qdrant video_transcript&#10;248 điểm · 56 video" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="1200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Q3" value="Qdrant rag_documents&#10;4 điểm" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="1200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="NQ" value="media_clip chứa CẢ ảnh tĩnh lẫn keyframe video,&#10;phân biệt bằng khoá payload media_kind&#10;(&quot;image&quot; / &quot;video_frame&quot;).&#10;Khoá payload là HỢP ĐỒNG: truy xuất và sinh câu&#10;trả lời đọc theo tên — đổi tên khoá là gãy cả hai." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1200" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="NQ2" value="56/59 video có lời thoại trong Qdrant.&#10;3 video còn lại: 2 chạy pipeline dở dang&#10;(có tiếng, ASR còn PENDING) + 1 ASR FAILED." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1200" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="P1" value="POST /api/documents/upload&#10;+ /ingest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="1355" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="P2" value="parser → cleaner → chunker&#10;(chia theo mục có tiêu đề)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="1355" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="P3" value="Nhúng — CÙNG pod, cùng model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="1355" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="NP" value="KHO NÀY CÒN QUÁ NHỎ: 4 chunk (~2.000 ký tự), chỉ có &quot;Nội quy sử dụng phòng&quot;.&#10;Vì 4 &lt; k=5 nên mọi truy vấn đều trả về TOÀN BỘ kho ⇒ Recall@5 = 1,000 là con số RỖNG, chỉ MRR mới có nghĩa.&#10;Đây là khoảng trống nội dung lớn nhất còn lại, không phải lỗi code." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe0e0;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
