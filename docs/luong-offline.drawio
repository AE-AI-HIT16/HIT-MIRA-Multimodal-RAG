        </mxCell>
        <mxCell id="lane7" value="7 · NHÁNH NỘI QUY — đi đường riêng, qua API chứ không qua script" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#9fb3c8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#334e68;" vertex="1" parent="1">
