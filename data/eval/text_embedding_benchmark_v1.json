{
  "meta": {
    "version": 2,
    "created_at": "2026-08-05",
    "status": "reviewed_label_precision_pooling_pending",
    "purpose": "Compare Azure text-embedding-3-small with jina-clip-v2 on Facebook post messages before deciding the text vector topology.",
    "corpus": "message from 505 non-empty messages among 514 unique post.json records",
    "document_id": "facebook_post_id",
    "metric_plan": [
      "Recall@5",
      "MRR@10",
      "nDCG@10",
      "warm_latency",
      "cold_latency",
      "out_of_scope_top_score",
      "false_positive_rate_at_threshold"
    ],
    "important_notes": [
      "Labels use stable Facebook post IDs, not UUIDs from the previous PostgreSQL/Qdrant environment.",
      "All 76 positive labels were reviewed against MinIO and exist under the dataset prefix.",
      "TXT-18 requires a created_time filter because its discriminative year is absent from the message; exclude it from the main vector-only aggregate.",
      "Do not compare cosine scores across Azure and Jina directly; compare ranks and retrieval metrics.",
      "The five out-of-scope queries report score distributions; a rejection threshold must be selected on a separate development split.",
      "The 76 positive labels are correct but not exhaustive. Final Recall/MRR/nDCG require blind adjudication of the pooled Azure and Jina candidates."
    ],
    "scope_limitations": [
      "This benchmark covers only the 505 non-empty Facebook post messages.",
      "It does not measure caption, OCR, transcript or text-to-image retrieval.",
      "Spoken-language transcript conclusions require a separately labeled corpus after ingestion."
    ]
  },
