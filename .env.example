# ============ App ============
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# ============ PostgreSQL (metadata + quan hệ) ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hit_mira
POSTGRES_USER=hit
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://hit:change-me@localhost:5432/hit_mira

# ============ Qdrant (3 collection: media / transcript / regulations) ============
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_MEDIA=media_clip
QDRANT_COLLECTION_TRANSCRIPT=video_transcript
QDRANT_COLLECTION_REGULATION=regulation_text

# ============ Object storage (media gốc) ============
# Mặc định POC: filesystem (data/raw). Đổi sang MinIO/S3 ở v2.
STORAGE_BACKEND=filesystem
DATA_DIR=./data

# ============ Providers (chốt model cụ thể ở HLD) ============
# Embedding đa phương thức (CLIP đa ngôn ngữ) + text embedder tiếng Việt
EMBED_IMAGE_MODEL=
EMBED_TEXT_MODEL=
# ASR
ASR_MODEL=whisper
# LLM sinh câu trả lời (free-tier) — chọn 1 provider
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
