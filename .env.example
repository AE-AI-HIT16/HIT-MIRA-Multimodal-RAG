# ============================================================
# HIT-MIRA Multimodal RAG — Unified Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# All paths are relative to the project root.

# ============ App ============
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
# JWT_SECRET / JWT_EXPIRE_MINUTES: KHÔNG được đọc ở đâu cả — tàn dư của bản
# thiết kế cũ. Biến thật của nhánh auth là AUTH_SECRET_KEY / AUTH_TOKEN_TTL_HOURS
# ở cuối file. Giữ lại hai dòng này chỉ để ai đang dùng .env cũ không hoang mang.
#JWT_SECRET=change-me
#JWT_EXPIRE_MINUTES=1440

# ============ PostgreSQL (metadata + quan hệ) ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hit_mira
POSTGRES_USER=hit
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://hit:change-me@localhost:5432/hit_mira

# ============ Qdrant ============
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Collection này chỉ dành cho nội quy dùng Azure text-embedding-3-small.
# Dùng tên mới để không trộn vector Azure 1536 chiều với collection Jina 1024
# chiều đã index trước đây. Sau khi điền Azure, cần ingest lại nội quy vào đây.
QDRANT_COLLECTION_NAME=rag_documents_azure_1536
QDRANT_DENSE_VECTOR_SIZE=1536

# ============ Object storage (media gốc) ============
STORAGE_BACKEND=filesystem
DATA_DIR=./data
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hit-mira-media
MINIO_SECURE=false
# Public S3 endpoint used only when signing URLs for remote Runpod workers.
# Keep MINIO_ENDPOINT private (for example minio:9000 inside Docker).
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=false

# ============ Runpod Serverless (offline GPU worker) ============
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2

# ============ OpenAI / LLM ============
OPENAI_API_KEY=
OPENAI_BASE_URL=http://3.25.91.72:20128/v1
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=cx/gpt-5.5

# ============ Azure OpenAI text embedding ============
# Dùng cho nội quy ngay ở v1; về sau dùng tiếp cho transcript/caption/OCR khi
# hybrid text index được triển khai. Ba giá trị trống dưới đây là phần cần điền.
# BASE_URL phải kết thúc bằng /openai/v1 (KHÔNG thêm /embeddings); LangChain sẽ
# tự nối endpoint. MODEL là TÊN DEPLOYMENT trên Azure, không nhất thiết trùng
# tên model gốc text-embedding-3-small.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
# Chunk nội quy hiện nhỏ hơn giới hạn model; gửi thẳng cho Azure để không phụ
# thuộc tokenizer cục bộ và tránh một lượt tải tokenizer không cần thiết.
EMBEDDING_CHECK_CTX_LENGTH=false

# ============ Jina visual embedding — RunPod tự host ============
# EMBED_SERVER_API_KEY là secret do mình tự đặt cho server trên RunPod.
# JINA_API_KEY phải giống hệt nó vì client hiện gửi biến này làm Bearer token.
EMBED_SERVER_API_KEY=
JINA_API_KEY=
MEDIA_IMAGE_EMBEDDING_MODEL=jina-clip-v2
# URL đầy đủ do scripts/deploy_embedding_pod.py --apply in ra, có /v1/embeddings.
MEDIA_IMAGE_EMBEDDING_BASE_URL=
# Tự host không có quota token của Jina API; giữ nhịp chỉ làm chậm batch.
MEDIA_EMBEDDING_TOKENS_PER_MINUTE=0
# Jina-CLIP v2 xử lý ảnh ở 512px. Gửi ảnh 2048px tốn gấp 6 lần token mà vector
# gần như không đổi (cosine 0.994). Đặt 0 để gửi nguyên kích thước.
MEDIA_IMAGE_EMBEDDING_MAX_SIDE=512
MEDIA_IMAGE_EMBEDDING_JPEG_QUALITY=90
# Gộp quá nhiều ảnh vào một request thì Jina trả 413 Payload Too Large.
MEDIA_IMAGE_EMBEDDING_BATCH_SIZE=8
MEDIA_TEXT_EMBEDDING_BATCH_SIZE=64
MEDIA_EMBEDDING_MAX_REQUEST_BYTES=5242880

# ============ VLM: caption + OCR cho ảnh và keyframe ============
# Ba biến MEDIA_VISION_* được ưu tiên hơn OPENROUTER_* (xem configuration.py).
# Bỏ trống thì rơi về OpenRouter. Endpoint phải tương thích OpenAI và nhận ảnh.
MEDIA_VISION_MODEL_NAME=
MEDIA_VISION_API_BASE_URL=
MEDIA_VISION_API_KEY=

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=qwen/qwen2.5-vl-72b-instruct
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=HIT-MIRA Multimodal RAG

# ============ ASR ============
# Model ASR KHÔNG cấu hình ở đây. Biến ASR_MODEL cũ không được đọc ở đâu cả và
# còn ghi sai (whisper), trong khi hệ thống chạy Zipformer qua sherpa-onnx.
# Giá trị thật: API/Resources/model.yaml → MEDIA_MODELS.ASR_MODEL_NAME

# ============ Retrieval ============
RETRIEVAL_TOP_K=3
RETRIEVAL_KEYWORD_THRESHOLD=0.5

# ============ Logging ============
LOG_DIR=./logs

# ============ LangSmith / LangChain Tracing (Optional) ============
# Chỉ bật khi đã có LANGCHAIN_API_KEY thật, nếu không mỗi lượt chat sẽ ném 403.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=HIT-MIRA-RAG
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ============ ChatBot — MCP Server ============
BASE_MCP_SERVER_URL=http://127.0.0.1:8091/mcp
BASE_MCP_SERVER_TRANSPORT=streamable_http

# ============ API — YAML Config Paths (relative to project root) ============
CONFIG_PATH=./API/Resources/dev.yaml
MODELS_PATH=./API/Resources/model.yaml
PROMPTS_PATH=./API/Resources/prompt.yaml

# ============ ChatBot — YAML Config Paths (relative to project root) ============
CHATBOT_CONFIG_PATH=./ChatBot/Resources/dev.yaml
CHATBOT_MODELS_PATH=./ChatBot/Resources/models.yaml
CHATBOT_MESSAGES_PATH=./ChatBot/Resources/messages.yaml
CHATBOT_PROMPTS_PATH=./ChatBot/Resources/prompts.yaml
CHATBOT_AGENTS_PATH=./ChatBot/Resources/agents.yaml

# ============ MCP nội quy → FastAPI ============
MCP_CONFIG_PATH=./mcp/Resources/dev.yaml
MCP_SERVER_NAME=internal_rules_rag
MCP_HOST=0.0.0.0
MCP_PORT=8091
MCP_TRANSPORT=streamable-http
MCP_BASE_URL=http://localhost:8000
MCP_TIMEOUT_SECONDS=60

# ============ Auth (T-51) ============
# BẮT BUỘC, tối thiểu 16 ký tự. Sinh một khoá:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Thiếu khoá thì nhánh auth ném AuthConfigurationError — cố ý. Sinh khoá ngẫu
# nhiên mỗi lần khởi động sẽ làm mọi token chết sau mỗi lần restart, và triệu
# chứng ("đăng nhập xong vẫn bị đá ra") không hề trỏ về nguyên nhân.
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_HOURS=12

# Tài khoản ĐẦU TIÊN đăng ký sẽ là admin; từ tài khoản thứ hai trở đi là user.
