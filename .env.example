# ============================================================
# HIT-MIRA Multimodal RAG — Unified Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# All paths are relative to the project root.

# ============ App ============
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# ============ PostgreSQL (metadata + quan hệ) ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hit_mira
POSTGRES_USER=hit
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://hit:change-me@localhost:5432/hit_mira

# ============ Qdrant ============
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_MEDIA=media_clip
QDRANT_COLLECTION_TRANSCRIPT=video_transcript
QDRANT_COLLECTION_REGULATION=regulation_text
QDRANT_COLLECTION_NAME=rag_documents
# Phải khớp EMBEDDING_DIMENSIONS bên dưới và số chiều thật của Jina-CLIP v2.
# Mọi collection đang chạy đều là 1024; để 1536 là sai và sẽ tạo nhầm collection.
QDRANT_DENSE_VECTOR_SIZE=1024

# ============ Object storage (media gốc) ============
STORAGE_BACKEND=filesystem
DATA_DIR=./data
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hit-mira-media
MINIO_SECURE=false
# Public S3 endpoint used only when signing URLs for remote Runpod workers.
# Keep MINIO_ENDPOINT private (for example minio:9000 inside Docker).
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=false

# ============ Runpod Serverless (offline GPU worker) ============
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2

# ============ OpenAI / LLM ============
OPENAI_API_KEY=
OPENAI_BASE_URL=http://3.25.91.72:20128/v1
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=cx/gpt-5.5

# ============ Embedding (nhánh nội quy) ============
# Cả hệ thống dùng CHUNG một model nhúng — xem mục "One embedding model" trong
# CLAUDE.md. Mặc định trỏ vào Jina cho khớp nhánh media; muốn dùng model text
# riêng cho nội quy thì đổi ba dòng dưới VÀ nhúng lại collection rag_documents.
EMBED_IMAGE_MODEL=
EMBED_TEXT_MODEL=
EMBEDDING_API_KEY=your_jina_api_key_here
# Trỏ được sang endpoint tự host như nhánh media. Lưu ý KHÁC nhau: ở đây là URL
# GỐC (không có "/embeddings") vì LangChain tự nối đuôi, còn
# MEDIA_IMAGE_EMBEDDING_BASE_URL bên dưới phải ghi đủ đường dẫn.
#   EMBEDDING_BASE_URL=https://<pod>-8100.proxy.runpod.net/v1
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL=jina-clip-v2
# LangChain tự cắt token bằng tokenizer tải từ HuggingFace; model nào không có
# repo ở đó (jina-clip-v2) thì phải tắt, nếu không sẽ ném OSError.
EMBEDDING_CHECK_CTX_LENGTH=false

# ============ Jina image embedding ============
JINA_API_KEY=your_jina_api_key_here
# Trỏ sang endpoint tự host để không phụ thuộc số dư Jina. Trọng số là CÙNG
# một model nên vector nằm cùng không gian với index cũ — đã đo, xem
# embedding_server/README.md. Bỏ trống thì dùng https://api.jina.ai/v1/embeddings.
# Khi tự host vẫn phải đặt JINA_API_KEY (giá trị bất kỳ, ví dụ "local"):
# service từ chối chạy nếu khoá rỗng.
MEDIA_IMAGE_EMBEDDING_BASE_URL=
# Jina tính 4.000 token cho mỗi ảnh 512px và chặn ở 100.000 token/phút. Bộ
# nhúng tự giữ nhịp dưới ngưỡng này; đặt 0 để tắt (chỉ nên dùng khi test).
# TỰ HOST thì đặt 0 — không còn hạn mức nào để né, giữ nhịp chỉ làm chậm.
MEDIA_EMBEDDING_TOKENS_PER_MINUTE=100000
# Jina-CLIP v2 xử lý ảnh ở 512px. Gửi ảnh 2048px tốn gấp 6 lần token mà vector
# gần như không đổi (cosine 0.994). Đặt 0 để gửi nguyên kích thước.
MEDIA_IMAGE_EMBEDDING_MAX_SIDE=512
MEDIA_IMAGE_EMBEDDING_JPEG_QUALITY=90
# Gộp quá nhiều ảnh vào một request thì Jina trả 413 Payload Too Large.
MEDIA_IMAGE_EMBEDDING_BATCH_SIZE=8
MEDIA_TEXT_EMBEDDING_BATCH_SIZE=64
MEDIA_EMBEDDING_MAX_REQUEST_BYTES=5242880

# ============ VLM: caption + OCR cho ảnh và keyframe ============
# Ba biến MEDIA_VISION_* được ưu tiên hơn OPENROUTER_* (xem configuration.py).
# Bỏ trống thì rơi về OpenRouter. Endpoint phải tương thích OpenAI và nhận ảnh.
MEDIA_VISION_MODEL_NAME=
MEDIA_VISION_API_BASE_URL=
MEDIA_VISION_API_KEY=

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=qwen/qwen2.5-vl-72b-instruct

# ============ ASR ============
# Model ASR KHÔNG cấu hình ở đây. Biến ASR_MODEL cũ không được đọc ở đâu cả và
# còn ghi sai (whisper), trong khi hệ thống chạy Zipformer qua sherpa-onnx.
# Giá trị thật: API/Resources/model.yaml → MEDIA_MODELS.ASR_MODEL_NAME

# ============ Retrieval ============
RETRIEVAL_TOP_K=5
RETRIEVAL_KEYWORD_THRESHOLD=0.5

# ============ Logging ============
LOG_DIR=./logs

# ============ LangSmith / LangChain Tracing (Optional) ============
# Chỉ bật khi đã có LANGCHAIN_API_KEY thật, nếu không mỗi lượt chat sẽ ném 403.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=HIT-MIRA-RAG
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ============ ChatBot — MCP Server ============
BASE_MCP_SERVER_URL=http://127.0.0.1:8091/mcp
BASE_MCP_SERVER_TRANSPORT=streamable_http

# ============ API — YAML Config Paths (relative to project root) ============
CONFIG_PATH=./API/Resources/dev.yaml
MODELS_PATH=./API/Resources/model.yaml
PROMPTS_PATH=./API/Resources/prompt.yaml

# ============ ChatBot — YAML Config Paths (relative to project root) ============
CHATBOT_CONFIG_PATH=./ChatBot/Resources/dev.yaml
CHATBOT_MODELS_PATH=./ChatBot/Resources/models.yaml
CHATBOT_MESSAGES_PATH=./ChatBot/Resources/messages.yaml
CHATBOT_PROMPTS_PATH=./ChatBot/Resources/prompts.yaml
CHATBOT_AGENTS_PATH=./ChatBot/Resources/agents.yaml

# ============ MCP nội quy → FastAPI ============
MCP_CONFIG_PATH=./mcp/Resources/dev.yaml
MCP_SERVER_NAME=internal_rules_rag
MCP_HOST=0.0.0.0
MCP_PORT=8091
MCP_TRANSPORT=streamable-http
MCP_BASE_URL=http://localhost:8000
MCP_TIMEOUT_SECONDS=60
