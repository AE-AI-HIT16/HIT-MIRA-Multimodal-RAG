# OpenAI API Key (For text-embedding-3-small and gpt-5.5)
OPENAI_API_KEY=your_openai_api_key_here
LOG_DIR =./logs
# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=rag_documents
QDRANT_DENSE_VECTOR_SIZE=1536

# Embedding
EMBEDDING_DENSE_MODEL=text-embedding-3-small
EMBEDDING_SPARSE_MODEL=Qdrant/bm25

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_KEYWORD_THRESHOLD=0.5

# LangSmith Tracing (Optional, for LangGraph pipeline)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=HIT-MIRA-RAG

CONFIG_PATH=./Resources/dev.yaml
MODELS_PATH=./Resources/models.yaml
PROMPTS_PATH=./Resources/prompts.yaml
