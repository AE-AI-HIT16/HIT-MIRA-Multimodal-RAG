# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Env & secrets ----
.env
.env.local
# Bản sao lưu .env cũng chứa khoá thật; '.env' ở trên không khớp được tên này.
.env.*
!.env.example
*.key
*.pem

# ---- Node / frontend ----
web/node_modules/
web/.next/
web/out/
web/.turbo/
npm-debug.log*

# ---- Data artifacts (KHÔNG commit media/embedding nặng) ----
data/**
!data/**/.gitkeep
# Tập đánh giá là MÃ NGUỒN của phép đo, không phải dữ liệu nặng: vài chục KB
# văn bản, và không có nó thì không ai tái lập được số trong docs/eval-report.md.
!data/eval/
!data/eval/eval_queries.yaml
!data/eval/eval_queries.json
!data/eval/text_embedding_benchmark_v1.json
# report.json thì sinh lại mỗi lần chạy — không commit, tránh diff nhiễu.
data/eval/report.json
# Lịch sự kiện thường niên do CLB cung cấp: cũng là mã nguồn của phép trích
# sự kiện, không phải kết quả sinh ra. Mất nó thì tên chuỗi lại về chỗ LLM tự
# đặt, và không ai biết `event_key` đúng ra phải là gì.
!data/events/
!data/events/su_kien_chuan.yaml
# Cache của lượt gọi LLM thì sinh lại được — không commit.
data/events/pass1_extractions.json
data/events/pass2_clusters.json

# ---- Models / caches ----
*.pt
*.onnx
.cache/
models/

# ---- Logs (mỗi lần chạy sinh file mới, KHÔNG commit) ----
logs/
*.log

# ---- Qdrant chạy local: binary, tarball và data volume ----
/qdrant
/qdrant-*.tar.gz
/storage/
/.qdrant-initialized

# ---- Pipeline artifacts (retrieval units, keyframe...) ----
/outputs/
/.tmp/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
*.swp
*.swo
