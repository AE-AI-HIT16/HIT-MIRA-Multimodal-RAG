# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Env & secrets ----
.env
.env.local
# Bản sao lưu .env cũng chứa khoá thật; '.env' ở trên không khớp được tên này.
.env.*
!.env.example
*.key
*.pem

# ---- Node / frontend ----
web/node_modules/
web/.next/
web/out/
web/.turbo/
npm-debug.log*

# ---- Data artifacts (KHÔNG commit media/embedding nặng) ----
data/**
!data/**/.gitkeep

# ---- Models / caches ----
*.pt
*.onnx
.cache/
models/

# ---- Logs (mỗi lần chạy sinh file mới, KHÔNG commit) ----
logs/
*.log

# ---- Qdrant chạy local: binary, tarball và data volume ----
/qdrant
/qdrant-*.tar.gz
/storage/
/.qdrant-initialized

# ---- Pipeline artifacts (retrieval units, keyframe...) ----
/outputs/
/.tmp/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
*.swp
*.swo
